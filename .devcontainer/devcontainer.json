{
    "name": "TeX Live (2024)",
    "image": "texlive/texlive:TL2024-historic",
    "customizations": {
        "vscode": {
            "settings": {
                "latex-workshop.latex.tools": [
                    {
                        "name": "latexmk (lualatex)",
                        "command": "latexmk",
                        "args": [
                            "-e",
                            "$lualatex                = 'lualatex --cmdx -file-line-error -synctex=1 -interaction=nonstopmode -halt-on-error %O %S'",
                            "-e",
                            "$bibtex               = 'upbibtex %O %B'",
                            "-e",
                            "$biber                = 'biber -u -U --output_safechars %O %B'",
                            "-e",
                            "$makeindex            = 'upmendex %O -o %D %S'",
                            "-lualatex",
                            "%DOC%"
                        ]
                    },
                    {
                        "name": "latexmk (lualatex, shell escape)",
                        "command": "latexmk",
                        "args": [
                            "-e",
                            "$lualatex                = 'lualatex --cmdx -file-line-error -synctex=1 -interaction=nonstopmode -halt-on-error -shell-escape %O %S'",
                            "-e",
                            "$bibtex               = 'upbibtex %O %B'",
                            "-e",
                            "$biber                = 'biber -u -U --output_safechars %O %B'",
                            "-e",
                            "$makeindex            = 'upmendex %O -o %D %S'",
                            "-lualatex",
                            "%DOC%"
                        ]
                    }
                ],
                "latex-workshop.latex.recipes": [
                    {
                        "name": "latexmk (lualatex)",
                        "tools": [
                            "latexmk (lualatex)"
                        ]
                    },
                    {
                        "name": "latexmk (lualatex, shell escape)",
                        "tools": [
                            "latexmk (lualatex, shell escape)"
                        ]
                    }
                ]
            },
            "extensions": [
                "james-yu.latex-workshop"
            ]
        }
    }
}