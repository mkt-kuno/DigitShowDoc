{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build HTML from Markdown (Windows)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/build-html.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            }
        },
        {
            "label": "Build HTML from Markdown (Linux/Mac)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/build-html.sh"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            }
        },
        {
            "label": "Build HTML from Markdown (Docker)",
            "type": "shell",
            "command": "docker",
            "args": [
                "run", "--rm",
                "-v", "${workspaceFolder}:/work",
                "-w", "/work",
                "node:20-alpine",
                "sh", "-c",
                "apk add --no-cache bash && chmod +x build-html.sh && ./build-html.sh"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            }
        },
        {
            "label": "Open documentation in browser",
            "type": "shell",
            "command": "start",
            "args": ["${workspaceFolder}/docs/index.html"],
            "windows": {
                "command": "cmd",
                "args": ["/c", "start", "${workspaceFolder}/docs/index.html"]
            },
            "linux": {
                "command": "xdg-open",
                "args": ["${workspaceFolder}/docs/index.html"]
            },
            "osx": {
                "command": "open",
                "args": ["${workspaceFolder}/docs/index.html"]
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Build and Open",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build HTML from Markdown (Windows)",
                "Open documentation in browser"
            ],
            "problemMatcher": []
        }
    ]
}