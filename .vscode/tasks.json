{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "LaTeX build",
            "type": "shell",
            "command": "docker",
            "args": [
                "run", "--rm",
                "-v", "${workspaceFolder}:/work:cached",
                "-v", "${workspaceFolder}/.cache/.texlive2024:/root/.texlive2024:cached",
                "-v", "${workspaceFolder}/.cache/luatex-cache:/usr/local/texlive/2024/texmf-var/luatex-cache:cached",
                "-w", "/work",
                "texlive/texlive:TL2024-historic",
                "latexmk",
                "-e", "$lualatex='lualatex --cmdx -file-line-error -synctex=1 -interaction=nonstopmode -halt-on-error %O %S'",
                "-e", "$bibtex='upbibtex %O %B'",
                "-e", "$biber='biber -u -U --output_safechars %O %B'",
                "-e", "$makeindex='upmendex %O -o %D %S'",
                "-lualatex",
                "main.tex"
            ],
            "options": {
                "env": { "TEXINPUTS": ".:/work//:"}
            },
            "group": "build",
            "problemMatcher": []
        },
    ]
}